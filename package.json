{
  "name": "va-trackos",
  "version": "1.0.0",
  "description": "Huddle TrackOS - Executive Client Workflows, VA Pipeline Tracker & Quality Assurance Hub",
  "main": "backend/src/server.js",
  "scripts": {
    "start": "node backend/src/server.js",
    "build": "npm --prefix backend install",
    "postinstall": "npm --prefix backend install",
    "dev": "nodemon backend/src/server.js",
    "test": "npm --prefix backend test",
    "db:init": "node backend/scripts/init-db.js",
    "create:admin": "node backend/scripts/create-admin.js",
    "seed:users": "node backend/scripts/seed-users.js",
    "setup:db": "mysql -u root < sql/schema.sql"
  },
  "keywords": [
    "huddle-trackos",
    "express",
    "mysql",
    "full-stack"
  ],
