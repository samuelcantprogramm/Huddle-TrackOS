# ==============================================================================
# Huddle TrackOS — Environment Configuration Template
# Copy this file to .env and customize for your local or cloud environment.
# ==============================================================================

# Server Runtime
PORT=5000
NODE_ENV=production

# ------------------------------------------------------------------------------
# Option A: Cloud MySQL Connection URL (Railway, Render, Aiven, PlanetScale)
# If set, this takes precedence over individual DB_* variables below.
# ------------------------------------------------------------------------------
# DATABASE_URL=mysql://root:password@containers-us-west-1.railway.app:3306/railway

# ------------------------------------------------------------------------------
# Option B: Individual MySQL Parameters (Localhost, XAMPP, VPS, AWS RDS)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=va_trackos
DB_CONNECTION_LIMIT=10
DB_SSL=false

# ------------------------------------------------------------------------------
# Security & Authentication (JWT)
# IMPORTANT: Generate a strong, unique secret for production!
# ------------------------------------------------------------------------------
JWT_SECRET=huddle_trackos_jwt_super_secure_production_secret_key_change_me_2026
JWT_EXPIRES_IN=24h

# ------------------------------------------------------------------------------
# CORS & File Uploads
# In production, set CLIENT_ORIGIN to your public domain (e.g. https://your-app.com)
# ------------------------------------------------------------------------------
CLIENT_ORIGIN=http://localhost:3000
UPLOAD_MAX_FILE_SIZE_MB=10
